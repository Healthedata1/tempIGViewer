<http://fhir.org/guides/onc/us-quality-core/ImplementationGuide/fhir.onc.us-quality-core> a fhir:ImplementationGuide ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "fhir.onc.us-quality-core"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide fhir.onc.us-quality-core</b></p><a name=\"fhir.onc.us-quality-core\"> </a><a name=\"hcfhir.onc.us-quality-core\"> </a><h2>USQualityCore</h2><p>The official URL for this implementation guide is: </p><pre>http://fhir.org/guides/onc/us-quality-core/ImplementationGuide/fhir.onc.us-quality-core</pre><div><p>The USQualityCore Implementation Guide defines a set of FHIR profiles with extensions and bindings needed to create interoperable, quality-focused applications. The profiles in this implementation guide derive from and extend the <a href=\"http://hl7.org/fhir/us/core\">US Core</a> profiles to provide a common foundation for building, sharing, and evaluating knowledge artifacts across quality improvement efforts in the US Realm.</p>\n</div></div>"
  ] ;
  fhir:ImplementationGuide.url [ fhir:value "http://fhir.org/guides/onc/us-quality-core/ImplementationGuide/fhir.onc.us-quality-core"] ;
  fhir:ImplementationGuide.version [ fhir:value "0.5.0"] ;
  fhir:ImplementationGuide.name [ fhir:value "USQualityCore"] ;
  fhir:ImplementationGuide.title [ fhir:value "2026 US Quality Core Implementation Guide"] ;
  fhir:ImplementationGuide.status [ fhir:value "active"] ;
  fhir:ImplementationGuide.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:ImplementationGuide.date [ fhir:value "2026-06-05"^^xsd:date] ;
  fhir:ImplementationGuide.publisher [ fhir:value "Office of the National Coordinator for Health Information Technology (ONC)"] ;
  fhir:ImplementationGuide.contact [
