  ] ;
  fhir:DeviceRequest.encounter [
     fhir:link <http://fhir.org/guides/onc/us-quality-core/Encounter/example> ;
     fhir:Reference.reference [ fhir:value "Encounter/example" ]
  ] ;
  fhir:DeviceRequest.authoredOn [ fhir:value "2015-01-15T13:15:00+01:00"^^xsd:dateTime] ;
  fhir:DeviceRequest.requester [
     fhir:link <http://fhir.org/guides/onc/us-quality-core/Practitioner/example> ;
