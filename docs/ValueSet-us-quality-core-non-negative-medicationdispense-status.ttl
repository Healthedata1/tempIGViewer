       fhir:ContactPoint.value [ fhir:value "https://www.healthit.gov/feedback" ]
     ]
  ] ;
  fhir:ValueSet.description [ fhir:value "This value set defines the set of codes that indicate a non-negated medication dispense status (i.e. codes that are not `declined`)"] ;
  fhir:ValueSet.jurisdiction [
     fhir:index 0 ;
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "urn:iso:std:iso:3166" ] ;
       fhir:Coding.code [ fhir:value "US" ] ;
       fhir:Coding.display [ fhir:value "United States of America" ]
     ] ;
     fhir:CodeableConcept.text [ fhir:value "USA" ]
  ] ;
  fhir:ValueSet.purpose [ fhir:value "This value set was defined to support the set of medication dispense statuses in FHIR that do not explicitly indicate a negative status (i.e. all the codes from the http://terminology.hl7.org/CodeSystem/medicationdispense-status code system that are not `declined`)."] ;
  fhir:ValueSet.compose [
     fhir:ValueSet.compose.include [
       fhir:index 0 ;
       fhir:ValueSet.compose.include.system [ fhir:value "http://terminology.hl7.org/CodeSystem/medicationdispense-status" ] ;
       fhir:ValueSet.compose.include.concept [
         fhir:index 0 ;
