# - resource -------------------------------------------------------------------

<http://fhir.org/guides/onc/us-quality-core/RelatedPerson/example> a fhir:RelatedPerson ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example"] ;
  fhir:Resource.meta [
