# - resource -------------------------------------------------------------------

<http://fhir.org/guides/onc/us-quality-core/MedicationStatement/example> a fhir:MedicationStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example"] ;
  fhir:Resource.meta [
