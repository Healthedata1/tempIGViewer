     ] ;
     fhir:CodeableConcept.text [ fhir:value "USA" ]
  ] ;
  fhir:ValueSet.purpose [ fhir:value "This value set was defined to support the set of task statuses in FHIR that do not explicitly indicate a negative status (i.e. all the codes from the http://hl7.org/fhir/task-status code system that are not `rejected`)."] ;
