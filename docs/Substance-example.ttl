# - resource -------------------------------------------------------------------

<http://fhir.org/guides/onc/us-quality-core/Substance/example> a fhir:Substance ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "example"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "http://fhir.org/guides/onc/us-quality-core/StructureDefinition/us-quality-core-substance" ;
